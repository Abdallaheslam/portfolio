rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidVisitorReview(data) {
      return data.keys().hasAll(['authorName', 'comment', 'rating', 'createdAt'])
        && data.keys().hasOnly(['authorName', 'comment', 'rating', 'createdAt'])
        && data.authorName is string
        && data.authorName.size() >= 2
        && data.authorName.size() <= 60
        && data.comment is string
        && data.comment.size() >= 5
        && data.comment.size() <= 600
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.createdAt is timestamp
        && data.createdAt == request.time;
    }

    // Public visitor reviews & ratings (no login required, immutable after submit)
    match /visitorReviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if request.query.limit != null && request.query.limit <= 50;
      allow create: if isValidId(reviewId) && isValidVisitorReview(incoming());
      allow update, delete: if false;
    }
  }
}
